EXPORTS += [
    "/../lfi-runtime/core/include/lfi_arch.h",
    "/../lfi-runtime/core/include/lfi_core.h",
    "/../lfi-runtime/linux/include/lfi_linux.h",
    "/../rlbox_lfi_sandbox/include/lfi_sepstack_invoker.hpp",
    "/../rlbox_lfi_sandbox/include/rlbox_lfi_sandbox.hpp",
]

SOURCES += [ "lfi-test.c" ]

if CONFIG["MOZ_DEBUG"]:
    LDFLAGS += [
        "-Wl,--whole-archive",
        "$(topsrcdir)/../lfi-runtime/build_debug/liblfi.a",
        "-Wl,--no-whole-archive"
    ]
else:
    LDFLAGS += [
        "-Wl,--whole-archive",
        "$(topsrcdir)/../lfi-runtime/build_release/liblfi.a",
        "-Wl,--no-whole-archive"
    ]

FINAL_LIBRARY = "xul"
