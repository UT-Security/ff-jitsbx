EXPORTS.mozilla.rlbox += [
    "/../rlbox_lfi_sandbox/include/lfi_sepstack_invoker.hpp",
    "/../rlbox_lfi_sandbox/include/rlbox_lfi_sandbox.hpp",
]

EXPORTS += [
    "/" + CONFIG["LFI_RUNTIME_DIR"] + "/core/include/lfi_arch.h",
    "/" + CONFIG["LFI_RUNTIME_DIR"] + "/core/include/lfi_core.h",
    "/" + CONFIG["LFI_RUNTIME_DIR"] + "/linux/include/lfi_linux.h",
]

SOURCES += [ "lfi-test.c" ]

if CONFIG["MOZ_DEBUG"]:
    OS_LIBS += [
        "-Wl,--whole-archive",
        "$(topsrcdir)/" + CONFIG["LFI_RUNTIME_DIR"] + "/build_debug/liblfi.a",
        "-Wl,--no-whole-archive"
    ]
else:
    OS_LIBS += [
        "-Wl,--whole-archive",
        "$(topsrcdir)/" + CONFIG["LFI_RUNTIME_DIR"] + "/build_release/liblfi.a",
        "-Wl,--no-whole-archive"
    ]

FINAL_LIBRARY = "xul"
