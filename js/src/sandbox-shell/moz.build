GeckoProgram("js", linkage=None)
if CONFIG["JS_BUNDLED_EDITLINE"]:
    DIRS += ["../editline"]
    USE_LIBS += ["editline"]

   
USE_LIBS += ["static:js-sandboxed"]

LDFLAGS += ["-u sbx_init"]

#include("../js-config.mozbuild")
#include("../js-cxxflags.mozbuild")
#TODO(abhishek): figure out if this needs to be included
#include("../js-standalone.mozbuild")

UNIFIED_SOURCES += [
    "js.cpp",
	"jsshell.cpp",
]

DEFINES["EXPORT_JS_API"] = True

LOCAL_INCLUDES += [
    "!..",
    "..",
]

OS_LIBS += CONFIG["EDITLINE_LIBS"]

# People expect the js shell to wind up in the top-level JS dir.
OBJDIR_FILES.js.src += ["!/dist/bin/js%s" % CONFIG["BIN_SUFFIX"]]
