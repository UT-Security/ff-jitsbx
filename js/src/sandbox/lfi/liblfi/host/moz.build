FINAL_LIBRARY = "lfi"

LOCAL_INCLUDES += [
	"..",
	"../arch"
]

if CONFIG["CPU_ARCH"] == "x86_64":
	LOCAL_INCLUDES += [
		"../arch/x64",
	]

if CONFIG["OS_ARCH"] == "Linux":
	SOURCES += [
		"linux/cpu.c",
		"linux/dir.c",
		"linux/info.c",
		"linux/path.c",
		"linux/prctl.c",
		"linux/random.c",
		"posix/file.c",
		"posix/time.c",
	]

	SOURCES += [
		"linux/futex.c",
		"posix/thread.c",
	]
