Library('lfi')

# Includes should be relative to parent path
LOCAL_INCLUDES += ["!.", "."]

EXPORTS += [
	"lfi.h"
]

USE_LIBS += ["mmap"]

OS_LIBS += [
    "rt",
]

CFLAGS += ["-std=gnu11"]

SOURCES += [
	"arch/amd64/amd64.c",
	"arch/amd64/runtime.S",
	"buddy.c",
	"engine.c",
	"err.c",
	"proc.c",
	"stack.c",
]
