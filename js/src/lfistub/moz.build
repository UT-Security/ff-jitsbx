GeckoProgram("lfistub", linkage=None)

USE_LIBS += ["static:whole-archive:js"]

SOURCES += [
	"boxrt.c",
	"boxrt_ret.S",
]


LDFLAGS += ["-static-pie", "-Wl,--export-dynamic", "-lc++", "-lc++abi"]

ASFLAGS += ["-g0"]
