GeckoProgram("lfistub", linkage=None)

USE_LIBS += ["static:js"]

SOURCES += [
	"!main.s",
	"!thread.c",
]

LibraryGeneratedFile("js", "main.s", "thread.c", script="GenerateLFIStubFiles.py", entry_point="generate_lfi_stub")

LDFLAGS += ["-static-pie", "-lc++", "-lc++abi"]

ASFLAGS += ["-g0"]
