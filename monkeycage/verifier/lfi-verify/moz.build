Library('lfiv')

# Includes should be relative to parent path
LOCAL_INCLUDES += ["!.", "."]

LIBRARY_DEFINES["ARCH_X64"] = True

SOURCES += [
	"src/x64_large/verify.c"
]

USE_LIBS += ["fadec"]

EXPORTS += [
	"src/include/lfiv.h",
]
