option(
    "--enable-js-sandbox",
    default=False,
    help="{Enable|Disable} the JavaScript sandbox.",
)

@depends("--enable-js-sandbox", target)
def js_sandbox(enable_js_sandbox, target):
    if enable_js_sandbox and target.cpu != "x86_64":
        die("--enable-js-sandbox works only on x86-64")

    is_linux = target.kernel == "Linux" and target.os == "GNU"
    if enable_js_sandbox and not is_linux:
        die("--enable-js-sandbox works only on GNU Linux")

    if enable_js_sandbox:
        return True

set_config("JS_SANDBOX", js_sandbox)
set_define("JS_SANDBOX", js_sandbox)

option(
    "--enable-lfi-toolchain",
    default=False,
    help="{Enable|Disable} sandboxed compilation with LFI toolchain.",
)

@depends("--enable-lfi-toolchain", js_sandbox, build_project)
def lfi_toolchain(lfi_toolchain, js_sandbox, build_project):
    if lfi_toolchain and js_sandbox and build_project == "js":
        return True

set_config("LFI_TOOLCHAIN", lfi_toolchain)
set_define("LFI_TOOLCHAIN", lfi_toolchain)

@depends(js_sandbox, lfi_toolchain)
def js_sandbox_api(js_sandbox, lfi_toolchain):
    if js_sandbox and not lfi_toolchain:
        return True

set_config("JS_SANDBOX_API", js_sandbox_api)
set_define("JS_SANDBOX_API", js_sandbox_api)

include("../js/moz.configure")
