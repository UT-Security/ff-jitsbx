option(
    "--enable-js-sandbox",
    default=False,
    help="{Enable|Disable} the JavaScript sandbox.",
)

@depends("--enable-js-sandbox", target)
def js_sandbox(enable_js_sandbox, target):
    if enable_js_sandbox and target.cpu != "x86_64":
        die("--enable-js-sandbox works only on x86-64")

    is_linux = target.kernel == "Linux" and target.os == "GNU"
    if enable_js_sandbox and not is_linux:
        die("--enable-js-sandbox works only on GNU Linux")

    if enable_js_sandbox:
        return True

set_config("JS_SANDBOX", js_sandbox)
set_define("JS_SANDBOX", js_sandbox)

@depends(build_project, js_sandbox)
def js_sandbox_api(build_project, js_sandbox):
	if js_sandbox and build_project in ("browser"):
		return True

set_config("JS_SANDBOX_API", js_sandbox_api)
set_define("JS_SANDBOX_API", js_sandbox_api)

option(
	"--js-sandbox-type",
	help="Select the type of sandboxing for the JavaScript engine.",
	nargs=1,
	when=js_sandbox,
	choices=("noop", "dylib", "lfi"),
	default="noop",
)

@depends("--js-sandbox-type", when=js_sandbox)
def js_sandbox_noop(js_sandbox_type):
	if js_sandbox_type[0] == "noop":
		return True

set_config("JS_SANDBOX_NOOP", js_sandbox_noop)
set_define("JS_SANDBOX_NOOP", js_sandbox_noop)

@depends("--js-sandbox-type", when=js_sandbox)
def js_sandbox_dylib(js_sandbox_type):
	if js_sandbox_type[0] == "dylib":
		return True

set_config("JS_SANDBOX_DYLIB", js_sandbox_dylib)
set_define("JS_SANDBOX_DYLIB", js_sandbox_dylib)

@depends("--js-sandbox-type", when=js_sandbox)
def js_sandbox_lfi(js_sandbox_type):
	if js_sandbox_type[0] == "lfi":
		return True

set_config("JS_SANDBOX_LFI", js_sandbox_lfi)
set_define("JS_SANDBOX_LFI", js_sandbox_lfi)

option(
    "--enable-js-sandbox-verify",
    default=False,
    help="{Enable|Disable} the JavaScript sandbox verifier",
)

@depends("--js-sandbox-verify", when=js_sandbox_lfi)
def js_sandbox_verify(enable_js_sandbox_verify):
	if enable_js_sandbox_verify:
		return True

set_config("JS_SANDBOX_VERIFY", js_sandbox_verify)
set_define("JS_SANDBOX_VERIFY", js_sandbox_verify)

option(
	"--enable-js-sandbox-dom-reflectors",
	default=False,
	help="{Enable|Disable} validating DOM Reflector JavaScript objects"
)

@depends("--js-sandbox-dom-reflectors", when=js_sandbox)
def js_sandbox_dom_reflectors(enable_js_sandbox_dom_reflectors):
	if enable_js_sandbox_dom_reflectors:
		return True

set_config("JS_SANDBOX_DOM_REFLECTORS", js_sandbox_dom_reflectors)
set_define("JS_SANDBOX_DOM_REFLECTORS", js_sandbox_dom_reflectors)
