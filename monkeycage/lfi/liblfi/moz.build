# file, You can obtain one at http://mozilla.org/MPL/2.0/.

Library('lfi')

# Includes should be relative to parent path
LOCAL_INCLUDES += ["!.", ".", "arch"]

if CONFIG["CPU_ARCH"] == "x86_64":
	LOCAL_INCLUDES += [
		"arch/x64",
	]

EXPORTS += [
	"include/lfi.h",
	"include/lfi_arch.h",
	"include/lfi_host.h",
	"include/lfi_tux.h",
]

USE_LIBS += ["boxmap", "cwalk", "mmap"]

OS_LIBS += [
    "rt",
]

CFLAGS += ["-std=gnu11"]

SOURCES += [
	"buf.c",
	"elfload.c",
	"elfsym.c",
	"err.c",
	"fd.c",
	"file.c",
	"host.c",
	"perf.c",
	"proc.c",
	"sys.c",
	"tux.c",
]

DIRS += [
	"host",
	"pal",
	"syscalls",
]

if CONFIG["CPU_ARCH"] == "x86_64":
	DIRS += [
		"arch/x64"
	]

	LOCAL_INCLUDES += [
		"arch/x64"
	]
