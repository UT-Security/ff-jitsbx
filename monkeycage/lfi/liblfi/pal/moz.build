FINAL_LIBRARY = "lfi"

LOCAL_INCLUDES += [
	"..",
	"../arch"
]

if CONFIG["CPU_ARCH"] == "x86_64":
	LOCAL_INCLUDES += [
		"../arch/x64",
	]

SOURCES += [
	"ctx.c",
	"platform.c",
	"vm.c",
]

if CONFIG["CPU_ARCH"] == "x86_64":
	DIRS += [
		"arch/x64",
	]
