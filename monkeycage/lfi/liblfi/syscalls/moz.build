FINAL_LIBRARY = "lfi"

LOCAL_INCLUDES += [
	"..",
	"../arch"
]

if CONFIG["CPU_ARCH"] == "x86_64":
	LOCAL_INCLUDES += [
		"../arch/x64",
	]

SOURCES += [
	"strace.c",
	"sys_clock.c",
	"sys_cwd.c",
	"sys_fcntl.c",
	"sys_file.c",
	"sys_info.c",
	"sys_ioctl.c",
	"sys_mem.c",
	"sys_none.c",
	"sys_prctl.c",
	"sys_proc.c",
	"sys_random.c",
	"sys_signal.c",
]

SOURCES += [
	"sys_thread.c"
]
