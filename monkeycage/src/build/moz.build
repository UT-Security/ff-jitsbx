if CONFIG["JS_SHARED_LIBRARY"]:
    GeckoSharedLibrary("js-caged", linkage=None)
    SHARED_LIBRARY_NAME = "mozjs-caged"   
else:
    Library("js-caged")
	
FORCE_STATIC_LIB = True
STATIC_LIBRARY_NAME = "js_caged"
NO_EXPAND_LIBS = True

DIST_INSTALL = True
