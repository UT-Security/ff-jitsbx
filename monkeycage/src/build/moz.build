#CONFIGURE_SUBST_FILES += [
#    "js-config",
#    "js.pc",
#]

if CONFIG["JS_SHARED_LIBRARY"]:
    GeckoSharedLibrary("js-sandboxed", linkage=None)
    SHARED_LIBRARY_NAME = "mozjs-sandboxed"   
else:
    Library("js-sandboxed")
	
FORCE_STATIC_LIB = True
STATIC_LIBRARY_NAME = "js_sandboxed"
NO_EXPAND_LIBS = True

SOURCES += [
    "./gen/lib/arch/x64/callback.S",
    "./gen/lib/arch/x64/trampolines.S",
    "./gen/lib/includes.c",
    "./gen/lib/lib.c",
]

EXPORTS.js.sandbox += [
    "./gen/sobox.h"
]

DIST_INSTALL = True
