]

EXPORTS.monkeycage.experimental += [
	"../public/experimental/JSStencil.h",
	"../public/experimental/SourceHook.h",
]

EXPORTS.monkeycage.friend += [
	"../public/friend/PerformanceHint.h",
	"../public/friend/UsageStatistics.h",
	"../public/friend/WindowProxy.h",
]

EXPORTS.monkeycage.unsafe += [
	"../public/SandboxImpl.h",
]

if CONFIG["JS_SANDBOX_NOOP"]:
	EXPORTS.monkeycage.unsafe += [
		"../public/SandboxNoop.h",
	]
elif CONFIG["JS_SANDBOX_DYLIB"]:
	EXPORTS.monkeycage.unsafe += [
		"../public/SandboxDylib.h",
	]
else:
	EXPORTS.monkeycage.unsafe += [
		"../public/SandboxNone.h",
	]

