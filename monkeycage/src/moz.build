if not CONFIG['JS_SANDBOX']: 
	FINAL_LIBRARY = "js"
else:
	FINAL_LIBRARY = "js-caged"

	DIRS += ["build"]

UNIFIED_SOURCES += [
	"Context.cpp",
	"GlobalObject.cpp",
	"Id.cpp",
	"Proxy.cpp",
	"Value.cpp",
	"Wrapper.cpp",
]

if CONFIG['JS_SANDBOX_NOOP']:
	USE_LIBS += ["js"]

if CONFIG['JS_SANDBOX_DYLIB']:
	include("/js/src/js-config.mozbuild")
	include("/js/src/js-cxxflags.mozbuild")

	CONFIGURE_DEFINE_FILES += [
		"/js/src/js-confdefs.h",
	]

	if not CONFIG["JS_STANDALONE"]:
		CONFIGURE_SUBST_FILES += [
			"/config/autoconf-js.mk",
			"/config/emptyvars-js.mk",
		]

	CONFIGURE_DEFINE_FILES += [
		"/js/src/js-config.h",
	]

	# Changes to internal header files, used externally, massively slow down
	# browser builds.  Don't add new files here unless you know what you're
	# doing!
	EXPORTS += [
		"!/js/src/js-config.h",
		"/js/src/jsapi.h",
		"/js/src/jsfriendapi.h",
		"/js/src/jspubtd.h",
		"/js/src/jstypes.h",
	]

	EXPORTS.js += [
		"/js/public/AllocationLogging.h",
		"/js/public/AllocationRecording.h",
		"/js/public/AllocPolicy.h",
		"/js/public/Array.h",
		"/js/public/ArrayBuffer.h",
		"/js/public/ArrayBufferMaybeShared.h",
		"/js/public/BigInt.h",
		"/js/public/BuildId.h",
		"/js/public/CallAndConstruct.h",
		"/js/public/CallArgs.h",
		"/js/public/CallNonGenericMethod.h",
		"/js/public/CharacterEncoding.h",
		"/js/public/Class.h",
		"/js/public/ComparisonOperators.h",
		"/js/public/CompilationAndEvaluation.h",
		"/js/public/CompileOptions.h",
		"/js/public/Context.h",
		"/js/public/ContextOptions.h",
		"/js/public/Conversions.h",
		"/js/public/Date.h",
		"/js/public/Debug.h",
		"/js/public/Equality.h",
		"/js/public/ErrorInterceptor.h",
		"/js/public/ErrorReport.h",
		"/js/public/Exception.h",
		"/js/public/ForOfIterator.h",
		"/js/public/GCAnnotations.h",
		"/js/public/GCAPI.h",
		"/js/public/GCHashTable.h",
		"/js/public/GCPolicyAPI.h",
		"/js/public/GCTypeMacros.h",
		"/js/public/GCVariant.h",
		"/js/public/GCVector.h",
		"/js/public/GlobalObject.h",
		"/js/public/HashTable.h",
		"/js/public/HeapAPI.h",
		"/js/public/HelperThreadAPI.h",
		"/js/public/Id.h",
		"/js/public/Initialization.h",
		"/js/public/Interrupt.h",
		"/js/public/JitCodeAPI.h",
		"/js/public/JSON.h",
		"/js/public/LocaleSensitive.h",
		"/js/public/MapAndSet.h",
		"/js/public/MemoryCallbacks.h",
		"/js/public/MemoryFunctions.h",
		"/js/public/MemoryMetrics.h",
		"/js/public/Modules.h",
		"/js/public/Object.h",
		"/js/public/OffThreadScriptCompilation.h",
		"/js/public/Principals.h",
		"/js/public/Printer.h",
		"/js/public/Printf.h",
		"/js/public/ProfilingCategory.h",
		"/js/public/ProfilingFrameIterator.h",
		"/js/public/ProfilingStack.h",
		"/js/public/Promise.h",
		"/js/public/PropertyAndElement.h",
		"/js/public/PropertyDescriptor.h",
		"/js/public/PropertySpec.h",
		"/js/public/ProtoKey.h",
		"/js/public/Proxy.h",
		"/js/public/Realm.h",
		"/js/public/RealmIterators.h",
		"/js/public/RealmOptions.h",
		"/js/public/RefCounted.h",
		"/js/public/RegExp.h",
		"/js/public/RegExpFlags.h",
		"/js/public/Result.h",
		"/js/public/RootingAPI.h",
		"/js/public/SavedFrameAPI.h",
		"/js/public/ScalarType.h",
		"/js/public/ScriptPrivate.h",
		"/js/public/ShadowRealmCallbacks.h",
		"/js/public/SharedArrayBuffer.h",
		"/js/public/SliceBudget.h",
		"/js/public/SourceText.h",
		"/js/public/StableStringChars.h",
		"/js/public/Stack.h",
		"/js/public/StreamConsumer.h",
		"/js/public/String.h",
		"/js/public/StructuredClone.h",
		"/js/public/SweepingAPI.h",
		"/js/public/Symbol.h",
		"/js/public/TelemetryTimers.h",
		"/js/public/TraceKind.h",
		"/js/public/TracingAPI.h",
		"/js/public/Transcoding.h",
		"/js/public/TypeDecls.h",
		"/js/public/UbiNode.h",
		"/js/public/UbiNodeBreadthFirst.h",
		"/js/public/UbiNodeCensus.h",
		"/js/public/UbiNodeDominatorTree.h",
		"/js/public/UbiNodePostOrder.h",
		"/js/public/UbiNodeShortestPaths.h",
		"/js/public/UbiNodeUtils.h",
		"/js/public/UniquePtr.h",
		"/js/public/Utility.h",
		"/js/public/Value.h",
		"/js/public/ValueArray.h",
		"/js/public/Vector.h",
		"/js/public/WaitCallbacks.h",
		"/js/public/Warnings.h",
		"/js/public/WasmFeatures.h",
		"/js/public/WasmModule.h",
		"/js/public/WeakMap.h",
		"/js/public/WeakMapPtr.h",
		"/js/public/Wrapper.h",
		"/js/public/WrapperCallbacks.h",
		"/js/public/Zone.h",
	]

	# This lives in mozglue/baseprofiler but we re-publish ourselves to support
	# standalone SpiderMonkey configurations.
	EXPORTS.js += [
		"!/mozglue/baseprofiler/public/ProfilingCategoryList.h",
	]

	# Public APIs that are experimental: the precise contour of the APIs may still
	# change, but they're at least plausible first passes at designing something.
	# We expose them as-is, buyer beware.
	EXPORTS.js.experimental += [
		"/js/public/experimental/CodeCoverage.h",
		"/js/public/experimental/CompileScript.h",
		"/js/public/experimental/CTypes.h",
		"/js/public/experimental/Intl.h",
		"/js/public/experimental/JitInfo.h",
		"/js/public/experimental/JSStencil.h",
		"/js/public/experimental/PCCountProfiling.h",
		"/js/public/experimental/SourceHook.h",
		"/js/public/experimental/TypedData.h",
	]

	# Friend APIs are APIs that either basically SpiderMonkey-internal, or their
	# contours are gross and terrible -- but the functionality is too important to
	# some embedder (often, Gecko) to just not expose anything or to agonize through
	# a clean design.  Use this only if you absolutely must, and feel free to
	# propose clean APIs to replace what's here!
	EXPORTS.js.friend += [
		"/js/public/friend/DOMProxy.h",
		"/js/public/friend/DumpFunctions.h",
		"/js/public/friend/ErrorMessages.h",
		"/js/public/friend/ErrorNumbers.msg",
		"/js/public/friend/JSMEnvironment.h",
		"/js/public/friend/PerformanceHint.h",
		"/js/public/friend/StackLimits.h",
		"/js/public/friend/UsageStatistics.h",
		"/js/public/friend/WindowProxy.h",
		"/js/public/friend/XrayJitInfo.h",
	]

	# "Shadow" API defines the internal layout of public JSAPI types like |JSObject|
	# and |JSString|, so that other *inline* public functions can efficiently access
	# their internal fields.
	#
	# Embedders must never include these headers themselves or use their contents.
	# These internal layout details are publicly exposed for access *only* so that
	# other public API definitions may use them.
	#
	# When adding new shadow structure definitions (or new fields/static constants
	# to existing structures) for access by inline methods, make sure to add static
	# asserts to the original header file to ensure that offsets and duplicated
	# constants are consistent.  (Long term, it might be worth figuring out some way
	# to back actual implementations *with* these shadow definitions to eliminate
	# this requirement.)
	EXPORTS.js.shadow += [
		"/js/public/shadow/Function.h",
		"/js/public/shadow/Object.h",
		"/js/public/shadow/Realm.h",
		"/js/public/shadow/Shape.h",
		"/js/public/shadow/String.h",
		"/js/public/shadow/Symbol.h",
		"/js/public/shadow/Zone.h",
	]

	EXPORTS.js.sandbox += [
		"/js/public/sandbox/Promise.h",
		"/js/public/sandbox/Proxy.h",
		"/js/public/sandbox/Wrapper.h",
	]

	selfhosted_inputs = [
		"/js/public/friend/ErrorNumbers.msg",
		# ProfilingCategoryList.h is being indirectly included, and it must be passed
		# here as an input, so it's generated before this self-hosted JS code
		# generation. Otherwise, it will intermittently fail to build.
		"!/mozglue/baseprofiler/public/ProfilingCategoryList.h",
		"/js/src/builtin/TypedArrayConstants.h",
		"/js/src/builtin/SelfHostingDefines.h",
		"/js/src/builtin/Utilities.js",
		"/js/src/builtin/Array.js",
		"/js/src/builtin/AsyncFunction.js",
		"/js/src/builtin/AsyncIteration.js",
		"/js/src/builtin/BigInt.js",
		"/js/src/builtin/Date.js",
		"/js/src/builtin/Error.js",
		"/js/src/builtin/Generator.js",
		"/js/src/builtin/Iterator.js",
		"/js/src/builtin/Map.js",
		"/js/src/builtin/Number.js",
		"/js/src/builtin/Object.js",
		"/js/src/builtin/Promise.js",
		"/js/src/builtin/Reflect.js",
		"/js/src/builtin/RegExp.js",
		"/js/src/builtin/RegExpGlobalReplaceOpt.h.js",
		"/js/src/builtin/RegExpLocalReplaceOpt.h.js",
		"/js/src/builtin/String.js",
		"/js/src/builtin/Set.js",
		"/js/src/builtin/Sorting.js",
		"/js/src/builtin/TypedArray.js",
		"/js/src/builtin/WeakMap.js",
		"/js/src/builtin/WeakSet.js",
	] + (
		[
			"/js/src/builtin/intl/NumberingSystemsGenerated.h",
			"/js/src/builtin/intl/Collator.js",
			"/js/src/builtin/intl/CommonFunctions.js",
			"/js/src/builtin/intl/CurrencyDataGenerated.js",
			"/js/src/builtin/intl/DateTimeFormat.js",
			"/js/src/builtin/intl/DisplayNames.js",
			"/js/src/builtin/intl/IntlObject.js",
			"/js/src/builtin/intl/ListFormat.js",
			"/js/src/builtin/intl/NumberFormat.js",
			"/js/src/builtin/intl/PluralRules.js",
			"/js/src/builtin/intl/RelativeTimeFormat.js",
			"/js/src/builtin/intl/SanctionedSimpleUnitIdentifiersGenerated.js",
		]
		if CONFIG["JS_HAS_INTL_API"]
		else []
	)

	if CONFIG["ENABLE_RECORD_TUPLE"]:
		selfhosted_inputs += ["/js/src/builtin/Tuple.js"]

	# Prepare self-hosted JS code for embedding
	GeneratedFile(
		"/js/src/selfhosted.out.h",
		"selfhosted.js",
		script="/js/src/builtin/embedjs.py",
		entry_point="generate_selfhosted",
		inputs=selfhosted_inputs,
	)

	if CONFIG["JS_HAS_CTYPES"]:
		if CONFIG["MOZ_SYSTEM_FFI"]:
			CXXFLAGS += CONFIG["MOZ_FFI_CFLAGS"]

	if CONFIG["JS_HAS_INTL_API"]:
		DIRS += [
			"../../intl/components",
		]

		USE_LIBS += ["intlcomponents"]

# Monkeycage specific API
EXPORTS.monkeycage += [
	"../public/Sandbox.h",
	"../public/SandboxCallback.h",
	"../public/SandboxStack.h",
	"../public/Tainted.h",
]

EXPORTS.monkeycage.tainted += [
	"../public/tainted/Maybe.h",
]

# Monkeycage API wrappers for JSAPI
EXPORTS += [
	"mcapi.h",
	"mcfriendapi.h",
]

EXPORTS.monkeycage += [
	"../public/CallAndConstruct.h",
	"../public/CompilationAndEvaluation.h",
	"../public/CompileOptions.h",
	"../public/Context.h",
	"../public/ContextOptions.h",
	"../public/Debug.h",
	"../public/ErrorReport.h",
	"../public/Exception.h",
	"../public/GCAPI.h",
	"../public/GCVector.h",
	"../public/GlobalObject.h",
	"../public/Id.h",
	"../public/Initialization.h",
	"../public/Interrupt.h",
	"../public/JSON.h",
	"../public/LocaleSensitive.h",
	"../public/MemoryCallbacks.h",
	"../public/MemoryMetrics.h",
	"../public/Principals.h",
	"../public/Promise.h",
	"../public/PropertyAndElement.h",
	"../public/Proxy.h",
	"../public/Realm.h",
	"../public/RealmIterators.h",
	"../public/RootingAPI.h",
	"../public/ShadowRealmCallbacks.h",
	"../public/SourceText.h",
	"../public/Stack.h",
	"../public/String.h",
	"../public/TypeDecls.h",
	"../public/Utility.h",
	"../public/Value.h",
	"../public/ValueArray.h",
	"../public/WaitCallbacks.h",
	"../public/Warnings.h",
	"../public/Wrapper.h",
	"../public/WrapperCallbacks.h",
