Library('fadec')

# Includes should be relative to parent path
LOCAL_INCLUDES += ["!.", "."]

EXPORTS += [
	"!fadec-decode-public.inc",
	"fadec.h",
]

SOURCES += [
	"decode.c",
	"format.c",
]

GeneratedFile(
	"fadec-decode-public.inc",
	script="parseinstrs.py",
	inputs=["instrs.txt"],
	entry_point="generate_decode_public"
)

GeneratedFile(
	"fadec-decode-private.inc",
	script="parseinstrs.py",
	inputs=["instrs.txt"],
	entry_point="generate_decode_private"
)

