FINAL_LIBRARY = "lfi"

# Includes should be relative to current path
LOCAL_INCLUDES += ["!.", "."]

if CONFIG["CPU_ARCH"] == "x86_64":
	DIRS += ["arch/x64"]

	LOCAL_INCLUDES += [
		"./arch/x64",
	]
elif CONFIG["CPU_ARCH"] == "aarch64":
	DIRS += ["arch/arm64"]

	LOCAL_INCLUDES += [
		"./arch/arm64",
	]
	

EXPORTS += [
	"include/lfi_arch.h",
	"include/lfi_core.h",
]

SOURCES += [
	"arch_asm.c",
	"box.c",
	"boxmap.c",
	"core.c",
	"ctx.c",
	"error.c",
	"extalloc.c",
	"log.c",
	"mmap.c",
	"trampoline.c"
]
