Library('lfi')

USE_LIBS += ["lfiv"]

DIRS += [
	"core",
	"linux",
]

LIBRARY_DEFINES["HAVE_SYS_FUTEX"] = True
LIBRARY_DEFINES["HAVE_SYS_GETDENTS64"] = True
LIBRARY_DEFINES["HAVE_SYS_GETRANDOM"] = True
LIBRARY_DEFINES["HAVE_SYS_MEMFD_CREATE"] = True
LIBRARY_DEFINES["HAVE_TIMESPEC_GET"] = True

LIBRARY_DEFINES["ENABLE_TLS_EXEC"] = True
LIBRARY_DEFINES["ENABLE_SEGUE"] = True
LIBRARY_DEFINES["CTXREG"] = True
LIBRARY_DEFINES["SINGLE_SANDBOX"] = True
LIBRARY_DEFINES["STORES_ONLY"] = True
LIBRARY_DEFINES["LAST_CALLBACK_KEY"] = True
